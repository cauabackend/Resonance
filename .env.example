# MLflow (dentro do compose; fora dele, o pipeline usa sqlite local se vazio)
MLFLOW_TRACKING_URI=http://mlflow:5000

# MinIO (compatível com S3). Troque a senha fora de desenvolvimento.
MINIO_ROOT_USER=resonance
MINIO_ROOT_PASSWORD=   # obrigatório: defina uma senha forte antes do compose up

# API
MODEL_REGISTRY_URI=models:/resonance@production
API_LOG_LEVEL=INFO
MODEL_VERSION_PIN=       # vazio = alias "production" (latest) do registry

# Web
VITE_API_BASE_URL=http://localhost:8000
